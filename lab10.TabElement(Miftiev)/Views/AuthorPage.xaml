<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:lab10.TabElement_Miftiev_.ViewModel"
             x:Class="lab10.TabElement_Miftiev_.Views.AuthorPage"
             Title="AuthorPage"
             x:DataType = "vm:MainViewModel">
    <ScrollView>
        <VerticalStackLayout
        Padding="30,0"
        Spacing="25"
        Margin="0,140,0,0">

            <Label
            Text="Добро пожаловать!"
            Style="{StaticResource Headline}"
            SemanticProperties.HeadingLevel="Level1" />

            <Border StrokeThickness="2">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="15" />
                </Border.StrokeShape>
                <Entry Placeholder="Логин" Text="{Binding Login}" />
            </Border>

            <Border StrokeThickness="2">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="15" />
                </Border.StrokeShape>
                <Entry Placeholder="Пароль"  IsPassword="true" Text="{Binding Password}" />
            </Border>

            <Button Text="Войти"  HorizontalOptions="Fill" Command="{Binding InButCommand}"/>

            <VerticalStackLayout Spacing="-12">
                <Label Text="нет акааунта?" HorizontalTextAlignment="Center" />

                <Button Command="{Binding GoToRegPageCommand}"
                 Text="Регистрация" 
                 TextColor="Black"
                 BackgroundColor="Transparent"
                 FontAttributes="Bold"/>

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>