<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SR2_Miftiev_.AddPlaylistPage"
             Title="AddPlaylistPage">
    <StackLayout Padding="10">
        <Entry Placeholder="Название плейлиста" x:Name="TitleEntry" />
        <Entry Placeholder="Описание" x:Name="DescriptionEntry" />
        <Button Text="Добавить плейлист" Clicked="OnAddPlaylistClicked" />
    </StackLayout>
</ContentPage>