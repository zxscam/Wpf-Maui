<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="lab7.HttpRequestsSending_Miftiev_.UpdatePage"
             Title="UpdatePage">
    <VerticalStackLayout>
        <Label Text="Ведите идентификатор продукта" />
        <Entry x:Name="Id"/>
        <Label Text="Ведите название продукта" />
        <Entry x:Name="Name"/>
        <Label Text="Ведите описание продукта" />
        <Entry x:Name="Desc"/>
        <Button Clicked="UpdateRequestBut" Text="Отправить запрос"/>
        <Label Text="" x:Name="AnswerRequestInformation" />
    </VerticalStackLayout>
</ContentPage>